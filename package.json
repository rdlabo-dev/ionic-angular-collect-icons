{
  "name": "@rdlabo/ionic-angular-collect-icons",
  "version": "3.0.0-0",
  "repository": {
    "type": "git",
    "url": "git@github.com:rdlabo-dev/ionic-angular-collect-icons.git"
  },
  "bugs": {
    "url": "git@github.com:rdlabo-dev/ionic-angular-collect-icons.git/issues"
  },
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": "./dist/index.js",
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "start": "jiti ./src/index.ts",
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "npm run build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "fmt": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepublishOnly": "npm run build",
    "release": "np --no-tests --no-publish"
  },
  "dependencies": {
    "@clack/core": "^0.5.0",
    "@clack/prompts": "^0.11.0",
    "@ionic/utils-terminal": "^2.3.5",
    "ionicons": "^8.0.0",
    "picocolors": "^1.1.0",
    "ts-dedent": "^2.2.0",
    "ts-morph": "^26.0.0"
  },
  "devDependencies": {
    "@angular-eslint/template-parser": "^21.0.0",
    "@types/node": "^18.19.28",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^0.34.6",
    "eslint": "^8.57.0",
    "jiti": "^1.21.0",
    "np": "^10.2.0",
    "prettier": "^3.2.5",
    "tsup": "8.3.5",
    "typescript": "^5.9.0",
    "vitest": "^0.34.6"
  },
  "peerDependencies": {
    "@angular-eslint/template-parser": "^21.0.0 || ^22.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
